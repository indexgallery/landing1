# Create local secrets: npm run setup
APP_ORIGIN=http://localhost:4173
ADMIN_PASSWORD=
SESSION_SECRET=
DATABASE_URL=postgres://catalog:local-catalog@localhost:5432/catalog
# Neon: use its pooled DATABASE_URL, including sslmode=require.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=catalog
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional CDN base URL including bucket path if needed.
S3_PUBLIC_URL=http://localhost:9000/catalog
# Alternative on Vercel: STORAGE_DRIVER=blob and set this secret.
BLOB_READ_WRITE_TOKEN=
